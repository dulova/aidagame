{
  "name": "muroblocks",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Муроблоки — маленькие игры для отдыха",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build && npm run check:bundles",
    "check:bundles": "node scripts/check-bundles.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "fake-indexeddb": "^6.2.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14"
  }
}
